# Copy this file to .env and edit the values before running setup.ps1 / setup.sh.
#
# Preferred F5 configuration: point the backend at a JSON file describing
# every environment. Run `python scripts/configure_environments.py` to create it.
F5_ENVIRONMENTS_FILE=f5_environments.json

# Legacy two-environment fallback. Keep these commented unless you need a
# backwards-compatible two-target setup instead of the JSON file above.
# F5_DMZ_NAME=Edge
# F5_DMZ_URL=https://f5-edge.example.org
# F5_DMZ_NODES=https://f5-edge-a.example.org,https://f5-edge-b.example.org
# F5_DMZ_MEMBER_NETWORKS=10.0.0.0/8
# F5_LAN_NAME=Internal
# F5_LAN_URL=https://f5-internal.example.org
# F5_LAN_NODES=https://f5-internal-a.example.org,https://f5-internal-b.example.org
# F5_LAN_MEMBER_NETWORKS=172.16.0.0/12

# Optional frontend overrides for production builds.
# Leave VITE_BACKEND_URL commented in local dev so the frontend uses the Vite proxy.
# VITE_BACKEND_URL=http://localhost:8889
# VITE_EMAIL_SMTP_HOST=smtp.example.org
# VITE_EMAIL_SMTP_PORT=1040
#
# Authentication model: LOGIN-ONLY. Users log in on the admin page with their
# own F5 username/password; F5 (plus AD-group membership) authorizes the login
# and returns a token, which gates every action. There is no APM header trust,
# no IP allowlist (your firewall handles that), and no operator/anonymous/
# read-only roles -- anyone who successfully logs in is an admin. Automated cert
# changes go through the HTTP Basic API at /api/v1/replace-cert (F5 authorizes).

# FERNET_KEY: 44-char base64-urlsafe key used to decrypt the encrypted READ-ONLY
# service account. Generate it with `python scripts/encrypt_service_account.py`.
# Without it, the background cache pre-warm and the cert-replace API's VIP
# discovery are disabled (interactive users still work via their own F5 login).
#
# HARDENING: prefer FERNET_KEY_FILE over putting the key in this .env. Point it
# at a file that is chmod 600, owned by the service user, and kept OUTSIDE the
# repo. When FERNET_KEY is blank the app reads the key from this file, so the
# key stays off the process environment and out of shell history / .env backups.
# FERNET_KEY_FILE=/etc/f5-portal/fernet.key
FERNET_KEY=

# Encrypted READ-ONLY F5 service account. Used only to pull data: the background
# cache pre-warm and the cert-replace API's VIP discovery. It never writes.
# Give it a least-privilege read-only F5 account. Interactive changes run as the
# logged-in user's own F5 token, so no write/admin account is stored here.
F5_SERVICE_ACCOUNT_FILE=f5_service_account.enc

# Service-account session cache TTL in seconds (default 1800 = 30 min).
# SERVICE_SESSION_TTL=1800

# SMTP config for outgoing email
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1040

# Team notification list (comma-separated). Email goes here on every new VIP request.
# TEAM_NOTIFY_EMAILS=

# Set to false to silence the requester confirmation email.
# REQUESTER_NOTIFY_ENABLED=true

# Email "From" for portal notifications and admin CC (optional).
# EMAIL_FROM=vip-portal@example.org
# ADMIN_CC_EMAIL=
# Email domain used to build "<username>@<domain>" for logged-in users.
# USER_EMAIL_DOMAIN=example.org

# -------- Security hardening (see AUTHENTICATION_FLOW.md) --------
# Comma-separated origins allowed by CORS. If empty, "*" is used (NOT recommended).
# ALLOWED_ORIGINS=https://vip-portal.example.org:5443,http://localhost:8080

# Tornado debug mode. Leave OFF in QA/production: when on it serves full Python
# tracebacks to clients and enables autoreload. Only "1"/"true"/"yes" enables it.
# APP_DEBUG=false

# Portal login token lifetime in seconds. Default 28800 (8h). Set 0 to disable expiry.
# ADMIN_TOKEN_TTL=28800

# /admin/login brute-force throttle. After LOGIN_MAX_ATTEMPTS failures within
# LOGIN_WINDOW_SECONDS, the source IP is locked out for LOGIN_LOCKOUT_SECONDS.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900

# -------- Background pre-warm scheduler --------
# The backend logs into every configured F5 on a timer and pre-fetches the VIP
# list (incl. each client-SSL profile's bound cert + expiry) and pool/node
# status. Stream handlers serve from this cache while it's fresh so end-users
# don't pay the F5 round trip on every page load.
#
# CREDENTIALS: by default the scheduler uses the Fernet-encrypted read-only
# service account (F5_SERVICE_ACCOUNT_FILE) decrypted on demand -- NO plaintext
# F5 password needs to live in the environment. The F5_BG_USERNAME / F5_BG_PASSWORD
# pair below is a DEPRECATED plaintext fallback used only when no encrypted read
# account is available; leave both blank in hardened deployments.
# F5_BG_USERNAME=
# F5_BG_PASSWORD=
# Refresh interval in seconds (default 600 = 10 min, minimum 15). Cache is
# considered stale after 2x this value.
# F5_BG_REFRESH_SECS=600
# Where the in-memory cache is persisted to disk so it survives restarts and
# is filled in even when the bg scheduler is off (admin live fetches write
# here too). Defaults to <repo>/cache. Leave blank to disable disk caching.
# F5_CACHE_DIR=
